# Copy to .env — that file is gitignored and never committed. This repository is public.
# Read by docker-compose.local.yml only; the released stack uses fintrace-infra/.env instead,
# which needs these same two values plus VERSION and the smoke test's client secret.
POSTGRES_PASSWORD=change-me

# Core validates tokens from this realm; it contains the realm name, so it never goes into
# application.yml.
FINTRACE_OAUTH2_ISSUER_URI=https://<keycloak-host>/realms/<realm>
